#!/bin/bash

echo "Running pre-commit hook: Checking for unresolved merge conflict markers..."

if grep -R -E "^<<<<<<< |^=======$|^>>>>>>> " app/ ; then
    echo "================================================================"
    echo "ERROR: Unresolved merge conflict markers detected in app/ code!"
    echo "Please resolve all conflicts before committing."
    echo "================================================================"
    exit 1
fi

exit 0
