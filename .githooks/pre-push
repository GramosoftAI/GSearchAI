#!/bin/bash

echo "Running pre-push hook: Checking for unresolved merge conflict markers..."

if grep -R -E "^<<<<<<< |^=======$|^>>>>>>> " app/ ; then
    echo "================================================================"
    echo "ERROR: Unresolved merge conflict markers detected in app/ code!"
    echo "Push rejected to prevent broken code from reaching remote."
    echo "================================================================"
    exit 1
fi

exit 0
