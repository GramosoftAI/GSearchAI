# GsearchAI — Environment Variables Reference
# Copy to .env and fill in real values before running.

DEEPINFRA_API_KEY=
DEEPINFRA_API_URL=https://api.deepinfra.com/v1/openai

MODEL_EMBEDDING=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=4096

MODEL_INTENT=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
MAX_TOKENS_INTENT=512

MODEL_EXTRACTION=deepseek-ai/DeepSeek-V4-Flash
MAX_TOKENS_EXTRACTION=512

MODEL_NL_TO_CYPHER=deepinfra/gpt-oss-120b
MAX_TOKENS_NL_TO_CYPHER=256

MODEL_RERANKER=Qwen/Qwen3-Reranker-4B
MAX_TOKENS_RERANKER=8

MODEL_MEMORY=meta-llama/Llama-3.1-8B-Instruct-Turbo
MAX_TOKENS_MEMORY=512

MODEL_ANSWER=deepseek-ai/DeepSeek-V3-2
MAX_TOKENS_ANSWER=1024

MODEL_VISION=meta-llama/Llama-3.2-11B-Vision-Instruct
MAX_TOKENS_VISION=1024

FALLBACK_MODE=false
MODEL_EXTRACTION_FALLBACK=meta-llama/Llama-3.1-8B-Instruct-Turbo
MODEL_NL_TO_CYPHER_FALLBACK=deepinfra/gpt-oss-20b
MODEL_RERANKER_FALLBACK=Qwen/Qwen3-Reranker-0.6B

LLM_LIVE_CONCURRENCY=10
LLM_BACKGROUND_CONCURRENCY=5

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
PGVECTOR_URL=postgresql://user:password@localhost:5432/gsearchai
